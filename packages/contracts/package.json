{
  "name": "@mycelium-llc/primal-contracts",
  "version": "1.0.1",
  "description": "Every Mycelium Primal component's contract as framework-independent JSON (promise, states, keys, accessibility, failures), its schema, and primal-contracts-check for your own.",
  "keywords": [
    "design-system",
    "component-contracts",
    "json-schema",
    "documentation",
    "accessibility",
    "design-system-tooling",
    "mycelium",
    "mycelium-primal"
  ],
  "homepage": "https://primal.myceliumllc.dev",
  "bugs": {
    "url": "https://github.com/Mycelium-LLC/primal-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mycelium-LLC/primal-ui.git",
    "directory": "packages/contracts"
  },
  "license": "MIT",
  "author": "Mycelium LLC <hello@myceliumllc.dev>",
  "type": "module",
  "bin": {
    "primal-contracts-check": "validate.mjs"
  },
  "exports": {
    "./contracts.json": "./contracts.json",
    "./schema.json": "./schema.json",
    "./validate.mjs": "./validate.mjs",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "schema.json",
    "contracts.json",
    "validate.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
