{
  "hosting": {
    "site": "mycelium-primal",
    "public": "dist/site",
    "cleanUrls": true,
    "headers": [
      { "source": "/version.json", "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(woff2|png|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ],
    "rewrites": [
      { "source": "/showcase/**", "destination": "/showcase/index.html" }
    ]
  }
}
